# strumsight:allow-secret-file — every secret-like key below is empty or a
# <placeholder>; NO real value is committed (ADR 0449 D6).
#
# StrumSight backend — staging deploy profile.
#
# Copy to a real `.env` (or export as environment variables in your deploy
# tooling) and fill in every <placeholder> from your secret manager / CI
# secret store — never by hand-editing a value into a copy of this file that
# then gets committed. `Settings._guard_staging` (app/config.py) refuses to
# boot if a secret-like field is still at its dev default.
#
# Staging MUST use its own database and media target, never production's —
# see docs/release/environment-matrix.md and docs/operations/backend-deploy.md.

STRUMSIGHT_ENV=staging

# --- Secrets — fill from your secret manager at deploy time, never here ---
STRUMSIGHT_SECRET_KEY=<generate with: openssl rand -hex 32>
STRUMSIGHT_DIAG_TOKEN=<a non-default diagnostics token, only if diagnostics is enabled below>
STRUMSIGHT_TUTOR_API_KEY=<the tutor provider's API key, only if tutor is enabled below>

# --- Network / CORS ---
STRUMSIGHT_CORS_ORIGINS=["https://staging.strumsight.app"]

# --- Trusted reverse-proxy hops (R14) ---
# JSON list, EMPTY by default. Only when the direct socket peer is listed here
# does the login/register throttle read the first `X-Forwarded-For` hop as the
# client identity (app/client_ip.py); the same value is handed to uvicorn's
# `--forwarded-allow-ips` by the image CMD. Behind a reverse proxy this must be
# the MEASURED address the container sees the proxy as — the docker-bridge
# gateway, or 127.0.0.1 in host-network mode. Measure it, never guess:
#   docker compose --env-file runtime.env logs api | head   # then compare with
#   docker network inspect <stack>_default -f '{{(index .IPAM.Config 0).Gateway}}'
# Never a range and never "*": an untrusted hop that gets listed here lets any
# caller pick its own throttle bucket. The proxy must also OVERWRITE the header
# (Caddy: `header_up X-Forwarded-For {remote_host}`) — see
# docs/operations/backend-live-deploy.md §7. Leave the key OUT (or write []) to
# keep the default; an EMPTY string is a JSON parse error at boot.
STRUMSIGHT_TRUSTED_PROXY_IPS=[]

# --- Database — staging's OWN instance, never production's ---
STRUMSIGHT_DATABASE_URL=postgresql+psycopg://strumsight:<db-password>@staging-db.internal:5432/strumsight_staging
STRUMSIGHT_ALLOW_SQLITE=false

# --- Lab surfaces — dark by default on staging; flip on deliberately ---
STRUMSIGHT_DIAGNOSTICS_ENABLED=false
STRUMSIGHT_APK_DOWNLOAD_ENABLED=false
STRUMSIGHT_DIAG_DIR=/var/lib/strumsight/diagnostics

# --- AI Tutor proxy — off by default; the API key above is required if true ---
# Four keys, all mandatory together (backend/app/main.py::_guard_tutor_provider
# refuses to BOOT if any is missing or still at its dev default — in every
# environment, not only prod):
#   PROVIDER          which adapter is built: fake (default) | anthropic | openai
#   MODEL             the concrete model id
#   ALLOWED_PROVIDERS the JSON allowlist the registry validates against; it stays
#                     {"fake": ["fake-model"]} until an operator extends it, so a
#                     typo fails the boot instead of half-working
#   API_KEY           the provider secret (above) — it never leaves the server
# Flip order: keys first, STRUMSIGHT_TUTOR_ENABLED last. Verify afterwards with
# GET /tutor/capability, which reports provider+model (never the key).
# Runbook + cost/limit and privacy notes: docs/operations/backend-live-deploy.md §7.2.
# NOTE: with a non-fake provider the student's message and the assembled context
# leave the server for a third party — check docs/privacy/data-inventory.yaml
# (`tutor_stream`) before flipping.
STRUMSIGHT_TUTOR_ENABLED=false
STRUMSIGHT_TUTOR_PROVIDER=fake
STRUMSIGHT_TUTOR_MODEL=fake-model
STRUMSIGHT_TUTOR_ALLOWED_PROVIDERS={"fake": ["fake-model"]}
# Optional endpoint overrides (only for a proxy/gateway in front of the
# provider — leave unset to reach the vendor directly):
#   STRUMSIGHT_TUTOR_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
#   STRUMSIGHT_TUTOR_OPENAI_BASE_URL=https://api.openai.com/v1

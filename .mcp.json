{
  "mcpServers": {
    "dart": {
      "command": "node",
      "args": [
        "tools/dart-mcp-launcher.mjs",
        "--enable",
        "cli",
        "--enable",
        "flutter_app_lifecycle"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "viking": {
      "command": "node",
      "args": [
        "/home/ubuntu/viking-bridge/index.mjs"
      ],
      "env": {
        "OPENVIKING_ENDPOINT": "http://127.0.0.1:1933",
        "OPENVIKING_AGENT": "claude-code",
        "OPENVIKING_ACCOUNT": "default",
        "OPENVIKING_USER": "default",
        "OPENVIKING_ROOT": "/music-theory"
      }
    }
  }
}
